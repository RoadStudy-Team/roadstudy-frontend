<?xml version="1.0" encoding="utf-8"?>
<!--
    스터디 섹션 카드 한 장. 값은 SectionCardAdapter 가 채운다.
    크기 기준은 fragment_home.xml 상단 설명을 참고한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="14dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="470dp"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- 윗줄: [자격증]                [선택됨] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:includeFontPadding="false"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:textColor="@color/rs_accent"
            android:textSize="28sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:includeFontPadding="false"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="@string/selected"
            android:textColor="@color/rs_accent"
            android:textSize="28sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Rs.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/tvFileName"
        style="@style/Rs.Text.Sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="28sp" />

    <!--
        다시 들을 개념 목록. 카드 가운데의 빈 곳을 채운다.
        layout_weight=1 로 남는 공간을 차지하고, 위쪽에 붙여 둔다(gravity=top).
        가운데 정렬을 하면 개념 수가 다른 카드끼리 "다시 들을 개념" 제목 높이가 어긋난다.
        글자 3칸(tvReview1~3)은 SectionCardAdapter 가 채우고, 비는 칸은 숨긴다.
    -->
    <LinearLayout
        android:id="@+id/reviewList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingTop="44dp">

        <TextView
            android:id="@+id/tvReviewListLabel"
            style="@style/Rs.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/review_list_label"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvReview1"
            style="@style/Rs.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvReview2"
            style="@style/Rs.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvReview3"
            style="@style/Rs.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="30sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_concepts" />

        <TextView
            android:id="@+id/tvConceptCount"
            style="@style/Rs.Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="30sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Rs.Text.Sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/progress_label"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvProgressPercent"
            style="@style/Rs.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar" />

    <!-- 오늘 복습   8개 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_inner_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp">

        <TextView
            style="@style/Rs.Text.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/review_label"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvReviewCount"
            style="@style/Rs.Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp" />
    </LinearLayout>
</LinearLayout>
