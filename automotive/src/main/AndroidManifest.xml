<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        TODO: Pleos 문서로 확인한 뒤 추가할 것
        - 주행 중 사용 가능 앱(DO, 주의분산 최적화) 선언 문법
        - 차량 앱 선언
        - 사용하는 Vehicle / NaviHelper 권한 (pleos.car.permission.*)
    -->

    <application
        android:allowBackup="false"
        android:appCategory="audio"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoadStudy.Automotive">

        <!-- 차량 런처 노출용 (Pleos Music/Audio 앱 가이드) -->
        <meta-data
            android:name="androidx.car.app.launchable"
            android:value="true" />

        <!--
            TODO: Pleos 창 정책상 가로·세로 모두 지원해야 한다. 지금은 도안이 가로 기준이라 landscape 로 고정했다.
        -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
