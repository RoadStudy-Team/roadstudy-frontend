<?xml version="1.0" encoding="utf-8"?>
<!--
    확인 퀴즈 결과 화면 (디자인 도안 10_quiz_result).
    가운데에 "N문제 중 M문제 맞혔어요"와 이번 주 정답률, 연속 학습일을 보여준다.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="56dp"
    android:paddingEnd="56dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/Rs.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quiz_result_label"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tvHeadline"
            style="@style/Rs.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textSize="68sp" />

        <!-- 통계 상자: 이번 주 정답률 | 연속 학습 -->
        <LinearLayout
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Rs.Text.Sub.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quiz_result_weekly"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/tvWeekly"
                    style="@style/Rs.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="64sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/rs_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Rs.Text.Sub.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/parked_stat_streak"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/tvStreak"
                    style="@style/Rs.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="64sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 버튼: 닫기 | 휴대폰 리포트에서 보기 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="104dp"
            android:layout_marginTop="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnClose"
                style="@style/Rs.Text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_choice"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="72dp"
                android:paddingEnd="72dp"
                android:text="@string/parked_close"
                android:textSize="34sp" />

            <LinearLayout
                android:id="@+id/btnReport"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="28dp"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="64dp"
                android:paddingEnd="56dp">

                <TextView
                    style="@style/Rs.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quiz_result_report"
                    android:textColor="@color/white"
                    android:textSize="34sp" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
