<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".mydata.MydataFragment">

    <LinearLayout
        android:id="@+id/layoutMyDataTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 자료"
            android:textColor="#F3F4F6"
            android:textSize="26sp"
            android:textStyle="bold" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEmptyFolder"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardBackgroundColor="#1C1F26"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#2D333D"
        app:strokeWidth="1.25dp"
        app:layout_constraintBottom_toTopOf="@id/tvEmptyTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:cardUseCompatPadding="false">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_folderfile"
            android:contentDescription="Empty Folder Icon"
            app:tint="#AEB4BC" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="아직 올린 자료가 없어요"
        android:textColor="#F3F4F6"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvEmptyDesc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardEmptyFolder" />

    <TextView
        android:id="@+id/tvEmptyDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="공부하던 노트를 올리면 출퇴근 복습 카드로 바꿔드려요"
        android:textColor="#8A9099"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/btnFirstUpload"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEmptyTitle" />

    <!-- "첫 자료 올리기" 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFirstUpload"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#5B9CF6"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="첫 자료 올리기"
        android:textColor="#07121F"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/tvSampleExperience"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEmptyDesc" />

    <TextView
        android:id="@+id/tvSampleExperience"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="32dp"
        android:padding="8dp"
        android:text="샘플 자료로 체험하기"
        android:textColor="#8C919A"
        android:textSize="12sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnFirstUpload" />

</androidx.constraintlayout.widget.ConstraintLayout>