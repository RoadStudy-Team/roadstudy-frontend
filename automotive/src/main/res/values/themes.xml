    앱 테마. 차량 앱은 낮밤 구분 없이 항상 어두운 테마를 쓰므로 values-night 는 만들지 않는다.
-->
<resources>
    <style name="Theme.RoadStudy.Automotive" parent="Theme.Material3.Dark.NoActionBar">
        <!-- 창 전체 배경색 -->
