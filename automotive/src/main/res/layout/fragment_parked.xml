<?xml version="1.0" encoding="utf-8"?>
<!--
    주차 후 복습 화면 (디자인 도안 08_parked_review). 정차(P단) 중이라 터치 입력을 받는다.
    위: 도착 요약과 진도 집계 / 가운데: 오늘 학습한 중요한 개념 카드 / 아래: 퀴즈, 닫기 버튼.
    크기 기준은 fragment_home.xml 상단 설명을 참고한다.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="48dp"
    android:paddingTop="40dp"
    android:paddingEnd="48dp"
    android:paddingBottom="36dp">

    <!-- ===== 상단: 도착 요약 ===== -->
    <TextView
        android:id="@+id/tvBadge"
        style="@style/Rs.Text.Bold"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:background="@drawable/bg_icon_box"
        android:gravity="center"
        android:text="@string/parked_badge"
        android:textColor="@color/rs_safe"
        android:textSize="56sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Rs.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="46sp"
        app:layout_constraintEnd_toStartOf="@id/statsRow"
        app:layout_constraintStart_toEndOf="@id/tvBadge"
        app:layout_constraintTop_toTopOf="@id/tvBadge" />

    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/Rs.Text.Sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- 오른쪽 집계: 알고 있어요 | 다시 들을게요 | 연속 학습 -->
    <LinearLayout
        android:id="@+id/statsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/Rs.Text.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/parked_stat_known"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvKnown"
                style="@style/Rs.Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="64sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/rs_border" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                style="@style/Rs.Text.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/parked_stat_relisten"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvRelisten"
                style="@style/Rs.Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="64sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/rs_border" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="0dp">

            <TextView
                style="@style/Rs.Text.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/parked_stat_streak"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvStreak"
                style="@style/Rs.Text.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="64sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="36dp"
        android:background="@color/rs_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBadge" />

    <!-- ===== 가운데: 오늘 학습한 중요한 개념 ===== -->
    <TextView
        android:id="@+id/tvSectionTitle"
        style="@style/Rs.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/parked_section_title"
        android:textSize="80sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topDivider" />

    <!--
        개념 카드 목록. 카드 모양은 item_parked_concept.xml, 채우기는 ParkedConceptAdapter.
        카드 높이는 고정(560dp)이고, 남는 세로 공간의 가운데에 놓는다 (bias 0.5).
    -->

    <TextView
        android:id="@+id/tvSectionCount"
        style="@style/Rs.Text.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:background="@drawable/bg_chip"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textColor="@color/rs_accent"
        android:textSize="48sp"
        app:layout_constraintBottom_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintStart_toEndOf="@id/tvSectionTitle"
        app:layout_constraintTop_toTopOf="@id/tvSectionTitle"
        app:layout_constraintVertical_bias="0.765" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerConcepts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginStart="-8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="-8dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle" />

    <!-- ===== 하단 ===== -->
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="24dp"
        android:background="@color/rs_border"
        app:layout_constraintBottom_toTopOf="@id/bottomRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomRow"
        android:layout_width="0dp"
        android:layout_height="104dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvAgainNotice"
            style="@style/Rs.Text.Sub.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 확인 퀴즈 버튼 (가운데) -->
        <LinearLayout
            android:id="@+id/btnQuiz"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingEnd="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvQuiz"
                style="@style/Rs.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="34sp" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- 닫기 버튼 (오른쪽) -->
        <TextView
            android:id="@+id/btnClose"
            style="@style/Rs.Text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="88dp"
            android:paddingEnd="88dp"
            android:text="@string/parked_close"
            android:textColor="@color/white"
            android:textSize="34sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
